{
  "name": "FanTheory",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "theory": {
      "type": "string"
    },
    "supporting_evidence": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "character",
        "plot",
        "lore",
        "bloodline",
        "future"
      ]
    },
    "votes_up": {
      "type": "number",
      "default": 0
    },
    "votes_down": {
      "type": "number",
      "default": 0
    },
    "is_confirmed": {
      "type": "boolean",
      "default": false
    },
    "is_denied": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "theory"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": true,
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}