      "type": "string",
      "description": "Section title"
    },
    "subtitle": {
      "type": "string",
      "description": "Section subtitle"
    },
    "content": {
      "type": "string",
      "description": "Main content in markdown"
    },
    "inTheChronicles": {
      "type": "string",
      "description": "How this appears in the story"
    },
    "orderNumber": {
      "type": "number",
      "description": "Display order"
    }
