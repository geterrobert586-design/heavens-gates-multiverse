{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "album": {
      "type": "string"
    },
    "chapter_tie": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mood": {
      "type": "string",
      "enum": [
        "intense",
        "spiritual",
        "street",
        "corporate",
        "melancholy",
        "triumphant",
        "hidden"
      ]
    },
    "audio_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "lyrics_excerpt": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "artist"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}